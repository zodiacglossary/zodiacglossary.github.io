---
// src/pages/compare/[id].astro
// A dedicated page (opened in a new tab from the "See also ›" bar) that shows
// how the SAME meaning is expressed across related lemmata. Rows come from TWO
// sources, merged with no duplication:
//   1. lemmata cross-linked to the headword (the crossLinks table)
//   2. lemmata that share a meaning with the headword (even without a crosslink)
import Layout from "../../components/Layout.astro";
import LemmaLink from "../../components/LemmaLink";
import Search from "../../components/Search";
import data from "../../../public/data.json";

// A lemma is usable if it has something to display and a primary meaning.
const valid = (l) => (l.original || l.transliteration) && l.primary_meaning;

// Normalize a meaning string so "King", "king " and "the king" all compare equal.
const norm = (s) => (s || "").toLowerCase().trim().replace(/^the\s+/, "");

// Every distinct meaning recorded for a lemma. Uses the `meanings` table, and
// falls back to `primary_meaning` when that table has no rows for the lemma.
// (The old code only did this fallback for cross-links, never the headword.)
const meaningsForLemma = (lid, lemmaObj) => {
  const fromTable = [
    ...new Set(
      data.meanings
        .filter(m => m.lemma_id === lid)
        .map(m => m.value)
        .filter(Boolean)
    ),
  ];
  if (fromTable.length > 0) return fromTable;
  const obj = lemmaObj || data.lemmata.find(l => l.lemma_id === lid);
  return obj && obj.primary_meaning ? [obj.primary_meaning] : [];
};

export async function getStaticPaths() {
  const validIds = new Set(data.lemmata.filter(valid).map(l => l.lemma_id));

  // (1) lemmata that have a valid cross-link
  const linked = new Set();
  for (const c of data.crossLinks) {
    if (validIds.has(c.lemma_id) && validIds.has(c.link)) {
      linked.add(c.lemma_id);
      linked.add(c.link);
    }
  }

  // (2) lemmata that share a normalized meaning with at least one OTHER lemma.
  // Build an index: meaning -> set of lemma_ids that carry it.
  const meaningIndex = new Map();
  for (const l of data.lemmata) {
    if (!validIds.has(l.lemma_id)) continue;
    for (const v of meaningsForLemma(l.lemma_id, l)) {
      const key = norm(v);
      if (!key) continue;
      if (!meaningIndex.has(key)) meaningIndex.set(key, new Set());
      meaningIndex.get(key).add(l.lemma_id);
    }
  }
  const meaningShared = new Set();
  for (const ids of meaningIndex.values()) {
    if (ids.size > 1) for (const lid of ids) meaningShared.add(lid);
  }

  // Build a page for any lemma reachable by EITHER route.
  const include = new Set([...linked, ...meaningShared]);
  return data.lemmata
    .filter(l => valid(l) && include.has(l.lemma_id))
    .map(l => ({ params: { id: l.lemma_id.toString() } }));
}

const id = Number(Astro.params.id);
const lemma = data.lemmata.find(l => l.lemma_id === id);

const currentMeanings = meaningsForLemma(id, lemma);
const currentMeaningSet = new Set(currentMeanings.map(norm));

// ---- Source 1: cross-linked lemmata (both directions of the table) ----
const crossLinked = data.crossLinks
  .filter(c => c.lemma_id === id || c.link === id)
  .map(c => (c.lemma_id === id ? c.link : c.lemma_id))
  .map(otherId => data.lemmata.find(l => l.lemma_id === otherId))
  .filter(t => t && valid(t));

const crossLinkedIds = new Set(crossLinked.map(t => t.lemma_id));

// ---- Source 2: lemmata that share a meaning with the headword ----
const meaningMatched = data.lemmata.filter(t =>
  t.lemma_id !== id &&
  valid(t) &&
  meaningsForLemma(t.lemma_id, t).some(v => currentMeaningSet.has(norm(v)))
);

// ---- Merge the two sources, keeping each lemma only once ----
const seen = new Set([id]);        // headword handled separately below
const related = [];
for (const t of [...crossLinked, ...meaningMatched]) {
  if (seen.has(t.lemma_id)) continue;
  seen.add(t.lemma_id);
  related.push(t);
}

// Build the rows: headword first (the reference), then each related lemma.
const rows = [
  {
    target: lemma,
    isCurrent: true,
    language: lemma.language_label,
    via: null,
    meanings: currentMeanings.map(v => ({ value: v, shared: true })),
  },
  ...related.map(t => {
    const values = meaningsForLemma(t.lemma_id, t);
    const isCross = crossLinkedIds.has(t.lemma_id);
    const sharesMeaning = values.some(v => currentMeaningSet.has(norm(v)));
    const via = isCross && sharesMeaning ? "cross-link + meaning"
              : isCross ? "cross-link"
              : "same meaning";
    return {
      target: t,
      isCurrent: false,
      language: t.language_label,
      via,
      meanings: values.map(v => ({
        value: v,
        shared: currentMeaningSet.has(norm(v)),
      })),
    };
  }),
];

// Headword pinned first, then group by language: headword's language, then A→Z.
rows.sort((a, b) => {
  if (a.isCurrent) return -1;
  if (b.isCurrent) return 1;
  const aHome = a.language === lemma.language_label ? 0 : 1;
  const bHome = b.language === lemma.language_label ? 0 : 1;
  if (aHome !== bHome) return aHome - bHome;
  return a.language.localeCompare(b.language);
});

const allMeanings = [
  ...new Set(rows.flatMap(r => r.meanings.map(m => m.value))),
];

const headword = lemma.transliteration || lemma.original;
---
<Layout title={"See also: " + headword + " (#" + lemma.lemma_id + ")"}>
  <Search client:load slot="search" />
  <p class="compare-back">
    <a href={`/lemma/${lemma.lemma_id}`}>← Back to {headword}</a>
  </p>
  <h1 class="compare-title">
    Cross-references
    <span class="compare-sub">for {headword}</span>
  </h1>
  <table class="comparison-table">
    <thead>
      <tr>
        <th>Lemma</th>
        <th>Language</th>
        <th>Match</th>
        <th>Meanings</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr class={row.isCurrent ? "current-row" : ""}>
          <td>
            {row.isCurrent ? (
              <span class="current-lemma">
                {row.target.transliteration || row.target.original}
              </span>
            ) : (
              <LemmaLink lemma={row.target} />
            )}
          </td>
          <td>{row.language}</td>
          <td>
            {row.via ? <span class="via-tag">{row.via}</span> : "—"}
          </td>
          <td>
            {row.meanings.length === 0 ? (
              <span class="no-meaning">—</span>
            ) : (
              row.meanings.map((m, i) => (
                <>
                  <span class={m.shared ? "meaning-chip shared" : "meaning-chip differs"}>
                    {m.value}
                  </span>
                  {i < row.meanings.length - 1 ? ", " : ""}
                </>
              ))
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>
