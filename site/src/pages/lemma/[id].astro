---
import Layout from "../../components/Layout.astro";
import LemmaLink from "../../components/LemmaLink";
import Search from "../../components/Search";
import data from "../../../public/data.json";
import CitationDisplay from "../../components/CitationDisplay.astro";

export async function getStaticPaths() {
  const predicate = l => (l.original || l.transliteration) && l.primary_meaning;
  return data.lemmata.filter(predicate).map((lemma) => ({
    params: { id: lemma.lemma_id.toString() },
  }));
}

const id = Number(Astro.params.id);
const lemma = data.lemmata.find(l => l.lemma_id === id);
const hasLogogram = (s) => /\p{Lu}(?!\p{Ll})/u.test(s ?? "");
const hasNumberOrMark = (s) => /[0-9?]/.test(s ?? "");
const showOriginal =
  lemma.language_id === 1
    ? hasLogogram(lemma.original) || hasNumberOrMark(lemma.original)
    : !!lemma.original;

// Headword line = transliteration for Akkadian, original for everything else.
const headword = lemma.language_id === 1 ? lemma.transliteration : lemma.original;
// Secondary line under the headword = original for Akkadian, transliteration for the rest.
const secondaryForm =
  lemma.language_id === 1
    ? (showOriginal ? lemma.original : null)
    : lemma.transliteration;
// Uppercase grammatical line, e.g. "AKKADIAN · VERB".
const grammarLine = [lemma.language_label, lemma.partofspeech_value].filter(Boolean).join(" · ");

const meanings = data.meanings.filter(m => m.lemma_id === id);
const meaningsWithQuotes = meanings.map(m => ({
  ...m,
  quotations: data.quotations.filter(q => q.meaning_id === m.meaning_id),
  categories: data.meaningCategories
      .filter(c => c.meaning_id === m.meaning_id)
      .map(c => c.category)
}));

// Group meanings by their word (value), preserving first-seen order.
// Result: [ { value: "Pleiades", senses: [...] }, { value: "Taurus", senses: [...] } ]
const groupedMeanings = [];
for (const m of meaningsWithQuotes) {
  let group = groupedMeanings.find(g => g.value === m.value);
  if (!group) {
    group = { value: m.value, senses: [] };
    groupedMeanings.push(group);
  }
  group.senses.push(m);
}

const uniqueCategories = [...new Set(meaningsWithQuotes.flatMap(m => m.categories))].filter(Boolean);

// Variants for this lemma, but drop any that are IDENTICAL to the headword
// (same spelling isn't a variant, it's just the same word).
const norm = (s) => (s ?? "").trim();
const sameAsLemma = (v) =>
  norm(v.transliteration) === norm(lemma.transliteration) &&
  norm(v.original) === norm(lemma.original);
const variants = data.variants
  .filter(v => v.lemma_id === id)
  .filter(v => !sameAsLemma(v));
const literalTranslation =
  (lemma.language_id === 1 && lemma.literal_translation2)
    ? lemma.literal_translation2
    : lemma.translation;
const quotations = data.quotations.filter(q => q.lemma_id === id);
const external = data.externalLinks.filter(e => e.lemma_id === id);
const lemmaEditors = data.users.filter(u => lemma.editor.split(", ").includes(u.username));
const crossLinks = data.crossLinks
  .filter(c => c.lemma_id === lemma.lemma_id || c.link === lemma.lemma_id)
  .map(c => {
    const otherId = c.lemma_id === lemma.lemma_id ? c.link : c.lemma_id;
    const target = data.lemmata.find(l => l.lemma_id === otherId);
    return { ...c, target };
  })
.filter(c => c.target && (c.target.original || c.target.transliteration) && c.target.primary_meaning);

// Related-lemma count for the "See also" bar: cross-links PLUS meaning matches.
const validLemma = (l) => (l.original || l.transliteration) && l.primary_meaning;
const normMeaning = (s) => (s || "").toLowerCase().trim().replace(/^the\s+/, "");
const meaningsForLemma = (lid, lemmaObj) => {
  const fromTable = [
    ...new Set(
      data.meanings.filter(m => m.lemma_id === lid).map(m => m.value).filter(Boolean)
    ),
  ];
  if (fromTable.length > 0) return fromTable;
  const obj = lemmaObj || data.lemmata.find(l => l.lemma_id === lid);
  return obj && obj.primary_meaning ? [obj.primary_meaning] : [];
};
const currentMeaningSet = new Set(meaningsForLemma(id, lemma).map(normMeaning));
const meaningMatched = data.lemmata.filter(t =>
  t.lemma_id !== id &&
  validLemma(t) &&
  meaningsForLemma(t.lemma_id, t).some(v => currentMeaningSet.has(normMeaning(v)))
);
const relatedSeen = new Set([id]);
let relatedCount = 0;
for (const t of [...crossLinks.map(c => c.target), ...meaningMatched]) {
  if (!t || relatedSeen.has(t.lemma_id)) continue;
  relatedSeen.add(t.lemma_id);
  relatedCount++;
}

const publicURL = `${Astro.site}${Astro.url.pathname.slice(1)}`;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": publicURL,
  url: publicURL,
  identifier: lemma.lemma_id.toString(),
  name: lemma.original,
  alternateName: lemma.transliteration,
  isPartOf: {
    "@type": "Dataset",
    identifier: "https://doi.org/10.5281/zenodo.17815712",
    url: Astro.site
  },
  creator: lemmaEditors.map(u => ({
    "@type": "Person",
    name: `${u.first_name} ${u.last_name}`,
    url: `${Astro.site}people/${u.id}`
  })),
  description: lemma.primary_meaning,
  inLanguage: lemma.language_label,
  relatedLink: crossLinks.map(c => ({
    "@id": `${Astro.site}lemma/${c.target.lemma_id}`,
  })),
  license: "https://creativecommons.org/licenses/by/4.0/",
  dateModified: lemma.last_edit,
};
---

<Layout title={(lemma.original || lemma.transliteration) + " (#" + lemma.lemma_id + ")"} jsonLD={jsonLD}>
  <Search client:load slot="search" />

  <div class={lemma.language_id === 1 ? "entry-head is-akkadian" : "entry-head"}>
    <h1 class="headword">{headword}</h1>

    {secondaryForm && (
      <div class="headword-secondary transliteration">{secondaryForm}</div>
    )}

    {grammarLine && <div class="grammar-line">{grammarLine}</div>}

    {variants.length > 0 && (
      <div class="variant-line">
        <span class="variant-label">variant{variants.length > 1 ? "s" : ""}</span>{" "}
        {variants.map((v, i) => (
          <span class="variant-item">
            {v.original}
            {v.transliteration && (
              <>: <span class="transliteration">{v.transliteration}</span></>
            )}
            {i < variants.length - 1 ? <span class="variant-sep">, </span> : null}
          </span>
        ))}
      </div>
    )}

    {(lemmaEditors.length > 0 || lemma.last_edit) && (
      <small class="last-edited">
        {lemmaEditors.length > 0 && (
          <>
            Edited by:{" "}
            {lemmaEditors.map((u, i) => (
              <>
                <a href={`/people/${u.id}`}>{u.first_name} {u.last_name}</a>
                {i < lemmaEditors.length - 1 ? ", " : ""}
              </>
            ))}
          </>
        )}
        {lemma.last_edit && (
          <>
            {lemmaEditors.length > 0 ? <br/> : null}
            Last edited: {new Date(lemma.last_edit).toISOString().split("T")[0]}
          </>
        )}
      </small>
    )}
  </div>

  <hr/>

  <div class="facts-bar">
    {groupedMeanings.length > 0 && (
      <div class="facts-cell">
        <small class="facts-label">Meanings</small>
        <div class="facts-value">
          {groupedMeanings.map((group, groupIndex) => (
            <div>
              <a class="meaning-index-link" href={`#group-${groupIndex}`}>
                {groupIndex + 1}. {group.value}
              </a>
            </div>
          ))}
        </div>
      </div>
    )}
    {literalTranslation && (
      <div class="facts-cell">
        <small class="facts-label">Literal translation</small>
        <div class="facts-value">{literalTranslation}</div>
      </div>
    )}
    {uniqueCategories.length > 0 && (
      <div class="facts-cell">
        <small class="facts-label">Categories</small>
        <div class="facts-value">
          {uniqueCategories.map(cat => (
            <div>{cat}</div>
          ))}
        </div>
      </div>
    )}
  </div>

  {relatedCount > 0 && (
    <a class="see-also-bar" href={`/compare/${lemma.lemma_id}`} target="_blank" rel="noopener">
      <span class="see-also-text">Related Lemmata</span>
      <span class="see-also-count">{relatedCount}</span>
      <span class="chev">›</span>
    </a>
  )}

  <hr/>

  <section class="meanings">
    {groupedMeanings.map((group, groupIndex) => (
      <div class="meaning-group" id={`group-${groupIndex}`}>
        <h3 class="group-heading">{groupIndex + 1}. {group.value}</h3>

        {group.senses.map((m, senseIndex) => (
          <details open id={`meaning-${m.meaning_id}`} class="meaning">
            <summary>
              <span class="sense-number">{groupIndex + 1}.{String.fromCharCode(97 + senseIndex)}</span>{" "}
              {m.value}
              {m.categories.length > 0 && (
                <span class="categories">{m.categories.join(", ")}</span>
              )}
            </summary>

            <div>
              {m.comment && <p class="comment">{m.comment}</p>}
              {m.quotations.map(q => (
                <blockquote>
                  <div class="quotation-text">
                    {q.original && <p>{q.original}</p>}
                    {q.transliteration && <p class="transliteration">{q.transliteration}</p>}
                  </div>
                  {q.translation && <p class="quotation-translation">‘{q.translation}’</p>}
                  <footer>
                    <cite>
                      <div>
                        — {q.source} {q.line}
                      </div>
                      <p class="quote-meta">
                        {q.genre && <span><strong>Genre:</strong> {q.genre}</span>}
                        {q.provenance && <span><strong>Provenance:</strong> {q.provenance}</span>}
                        {q.date && <span><strong>Date:</strong> {q.date}</span>}
                      </p>
                      <p><small>
                        {q.publication}
                        {q.page}
                      </small></p>
                      {q.comment && <p>{q.comment}</p>}
                    </cite>
                  </footer>
                </blockquote>
              ))}
            </div>
          </details>
        ))}
      </div>
    ))}
  </section>

  {external.length > 0 &&
    <article>
      <header>External links</header>
      <ul>
        {external.map(e => <li><a href={e.url}>{e.display}</a></li>)}
      </ul>
    </article>
  }

  <hr/>

  <article>
    <header>Cite this entry</header>
    <CitationDisplay entry={{
     id: "zodiac"+lemma.lemma_id,
     type: "webpage",
     author: lemmaEditors.map(u => ({given: u.first_name, family: u.last_name})),
     title: (lemma.original || lemma.transliteration) + " (Lemma #" + lemma.lemma_id + ")",
     "container-title": "The ZODIAC Glossary: A Cross-Cultural Glossary of Ancient Astral Science",
     issued: lemma.last_edit ? {"date-parts": [new Date(lemma.last_edit).getFullYear()]} : null,
     URL: publicURL,
     accessed: {"date-parts": [new Date().getFullYear(), new Date().getMonth() + 1, new Date().getDay()]}
     }} />
  </article>
</Layout>
